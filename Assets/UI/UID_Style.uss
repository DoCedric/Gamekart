:root {
    -unity-font-definition: url("project://database/Assets/UI/Font/LuckiestGuy-Regular.ttf?fileID=12800000&guid=31399da74fbd4c44e8501c8dec03931f&type=3#LuckiestGuy-Regular");
    -unity-font-style: normal;
    color: rgb(255, 255, 255);
}

.position {
    font-size: 120px;
}

.time {
    -unity-text-align: upper-right;
    font-size: 50px;
    -unity-font-style: normal;
}

.top-right {
    align-items: flex-end;
}

.lap {
    -unity-text-align: upper-right;
    font-size: 40px;
}

.countdown-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.countDownEnd {
    -unity-text-align: middle-center;
    white-space: nowrap;
    font-size: 200px;
    scale: 1 1;
    opacity: 1;
    transition-property: scale, opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}

.countDownStart {
    scale: 1.6 1.6;
    opacity: 0;
    transition-duration: 0s;
    color: rgb(255, 0, 0);
}
