<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UID_Style.uss?fileID=7433441132597879392&amp;guid=29af387596a4a0848829a2c60487a214&amp;type=3#UID_Style"/>
    <ui:VisualElement style="flex-grow: 1; margin-left: 50px; margin-top: 50px; margin-right: 50px; margin-bottom: 50px; flex-direction: row; align-items: stretch; justify-content: space-between;">
        <ui:Label text="1st" name="position" class="position"/>
        <ui:VisualElement name="top-right" class="top-right">
            <ui:Label text="00:00:00" name="time" class="time"/>
            <ui:Label text="LAP 0/3" name="lap" class="lap"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="countdown-overlay" picking-mode="Ignore" class="countdown-overlay">
        <ui:Label text="3" name="countdown" picking-mode="Ignore" class="countDownEnd" style="color: rgb(255, 232, 0); -unity-text-outline-width: 10px; -unity-text-outline-color: rgb(255, 116, 0); text-shadow: 0 0 0 rgb(0, 0, 0);"/>
    </ui:VisualElement>
</ui:UXML>
